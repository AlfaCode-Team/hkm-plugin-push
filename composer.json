{
    "name": "alfacode-team/hkm-plugin-push",
    "description": "Device-token registration and push delivery (FCM), with per-recipient fan-out and a delivery outbox.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4"
    },
    "autoload": {
        "psr-4": {
            "Plugins\\Push\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Plugins\\Push\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
